# Samsung Frame TV Art Manager — Environment Variables
#
# Copy this file to .env and customize for your setup.
# Only TV_IPS is required; everything else has sensible defaults.

# ─── Required ────────────────────────────────────────────────────────────────

# Comma-separated list of TV IP addresses
# Example: TV_IPS=192.168.1.100,192.168.1.101
TV_IPS=192.168.1.100

# ─── Core Settings ───────────────────────────────────────────────────────────

# How often to check and sync artwork (minutes)
# Default: 5
# SYNC_INTERVAL_MINUTES=5

# Client identity for WebSocket handshake.
# A stable name prevents Allow/Deny popups on reconnect.
# Default: Frame Art Manager
# CLIENT_NAME=Frame Art Manager

# Matte/border style for uploaded artwork.
# Format: {style}_{color} or "none" for full-screen.
#
# Styles: modernthin, modern, modernwide, flexible, shadowbox,
#         panoramic, triptych, mix, squares
# Colors: black, neutral, antique, warm, polar, sand, seafoam, sage,
#         burgandy, navy, apricot, byzantine, lavender, redorange,
#         skyblue, turquoise
#
# Examples: shadowbox_polar, modern_apricot, none
# Default: none
# MATTE_STYLE=none

# Log level: debug, info, warn, error
# Default: info
# LOG_LEVEL=info

# ─── Cleanup ─────────────────────────────────────────────────────────────────

# Remove images on TV that aren't tracked by this service.
# Default: false
# REMOVE_UNKNOWN_IMAGES=false

# ─── Wake-on-LAN ─────────────────────────────────────────────────────────────

# MAC address for Wake-on-LAN. A packet is sent only after the TV is positively
# identified and observed as powered off; unknown state never authorizes Wake.
# TV_MAC=AA:BB:CC:DD:EE:FF

# Maximum time allowed for graceful process shutdown (default: 30).
# SHUTDOWN_TIMEOUT_SECONDS=30

# ─── REST Gate ───────────────────────────────────────────────────────────────

# Enable the Silent REST Gate (probes port 8001 /ms/art before connecting).
# This prevents popups when the TV is running Netflix/YouTube, but may not
# work on all firmware versions. If your TV always returns 404, leave disabled.
# Default: false
# ENABLE_REST_GATE=false

# ─── Slideshow ───────────────────────────────────────────────────────────────

# DEFAULT BEHAVIOR (if none of these are set):
#   The script preserves and restores your TV's current slideshow settings.
#
# OVERRIDE BEHAVIOR (if any of these are set):
#   The script controls slideshow via these variables.

# SLIDESHOW_ENABLED=true
# SLIDESHOW_INTERVAL=15     # minutes (e.g. 3, 15, 60, 720, 1440)
# SLIDESHOW_TYPE=shuffle     # shuffle or sequential

# ─── Brightness ──────────────────────────────────────────────────────────────

# Option 1: Manual brightness (fixed value 0-50, applied every sync cycle)

# BRIGHTNESS=5

# Option 2: Solar brightness (automatic, based on sun position)
# Note: Solar takes precedence over manual if both are set.
# SOLAR_BRIGHTNESS_ENABLED=true
# Required when SOLAR_BRIGHTNESS_ENABLED is true.
# LOCATION_LATITUDE=42.3601
# Required when SOLAR_BRIGHTNESS_ENABLED is true.
# LOCATION_LONGITUDE=-71.0589
# LOCATION_TIMEZONE=America/New_York
# BRIGHTNESS_MIN=2          # brightness when sun is below horizon
# BRIGHTNESS_MAX=10         # brightness when sun is at zenith

# ─── Auto-Off ────────────────────────────────────────────────────────────────

# Automatically turn off TVs in art mode at a specific time.
# TVs being used for other content (HDMI, apps) are left alone.
# Requires LOCATION_TIMEZONE to be set.

# AUTO_OFF_TIME=22:00        # 24-hour format
# AUTO_OFF_GRACE_HOURS=2     # hours after AUTO_OFF_TIME to keep trying

# ─── Ownership & Permissions (Docker) ────────────────────────────────────────
#
# PUID and PGID ensure the folders created on the host have the correct
# permissions for your user.
# PUID=1000
# PGID=1000

# ─── Paths ───────────────────────────────────────────────────────────────────

# ARTWORK_DIR=/data/artwork
# TOKEN_DIR=/data/tokens

# ─── Image Sources & APIs ────────────────────────────────────────────────────

# File containing image URLs or source queries to download.
# Default: (empty)
# ARTWORK_SOURCES_FILE=/data/sources.yaml

# Unsplash API Configuration
# UNSPLASH_APP_ID=
# UNSPLASH_ACCESS_KEY=
# UNSPLASH_SECRET_KEY=

# NASA API Key (defaults to DEMO_KEY if empty)
# NASA_API_KEY=DEMO_KEY

# Pexels API Key
# PEXELS_API_KEY=

# Pixabay API Key
# PIXABAY_API_KEY=

# ─── Image Optimization & Processing ─────────────────────────────────────────

# Enable image validation and transformation to the configured target.
# Default: true
# IMAGE_OPTIMIZE_ENABLED=true

# Exact transformed output dimensions (default is 4K resolution).
# IMAGE_MAX_WIDTH=3840
# IMAGE_MAX_HEIGHT=2160

# Safety limits for output size and estimated live transform memory.
# IMAGE_MAX_OUTPUT_PIXELS=12000000
# IMAGE_MAX_WORKING_MEMORY_MB=512

# JPEG encoding quality (1-100)
# Default: 95
# IMAGE_JPEG_QUALITY=95

# Enable normalized BMS/edge/skin/color saliency cropping. The default gain
# threshold below is the conservative general-purpose preset.
# Default: false
# SMART_CROP_ENABLED=false

# Required saliency-score improvement over center crop (0-1).
# Default: 0.03
# SMART_CROP_MIN_GAIN=0.03

# Transform PNG inputs while preserving PNG output and alpha.
# Default: true
# IMAGE_OPTIMIZE_PNG=true

# Resample RGB in linear light to avoid dark resize fringes.
# Default: true
# IMAGE_LINEAR_LIGHT_RESIZE=true

# Conservative scale-aware luminance unsharp mask. Amount is the 1:1 baseline;
# downscales receive a bounded lift and upscales a reduction. Amount 0 disables it.
# Defaults: amount 0.25, threshold 4
# IMAGE_SHARPEN_AMOUNT=0.25
# IMAGE_SHARPEN_THRESHOLD=4

# Go's decoders do not transform embedded ICC profiles. Either assume decoded
# samples are sRGB (and warn) or reject images carrying color metadata.
# Options: assume-srgb, reject-embedded
# IMAGE_COLOR_PROFILE_POLICY=assume-srgb

# How to handle vertical portrait photos.
# Options: collage (join side-by-side pairs), pad (blurred background bars), crop.
# This policy applies uniformly to local, provider, and uploaded images.
# Default: crop
# PORTRAIT_MODE=crop

# Enable the optional creative treatment (canvas texture, warming, etc.).
# Enabling it without further tuning uses the balanced intensity-5 preset.
# Default: false
# IMAGE_MUSEUM_MODE=false

# Creative-treatment strength (1-10); 5 is the balanced preset.
# Default: 5
# IMAGE_MUSEUM_INTENSITY=5

# Maximum number of images to sync (0 means no local limit, filling to the TV's max available storage)
# Default: 0
# MAX_ARTWORK_IMAGES=0

# Maximum download size per image in megabytes
# Default: 20
# MAX_DOWNLOAD_SIZE_MB=20

# ─── Advanced System Settings ────────────────────────────────────────────────

# Enable TLS/SSL certificate verification when connecting to the TV.
# Default is false since Frame TVs use self-signed certificates.
# VERIFY_TLS=false
# Skip TLS verification regardless of VERIFY_TLS setting (useful for strictly local setups)
# Default: false
# SKIP_TLS_VERIFY=false

# Enable read-only planning (no local, token, state, Wake-on-LAN, upload, or TV mutation)
# Default: false
# DRY_RUN=false

# Port for HTTP /health and /status endpoints.
# Note: Setting this to 0 completely disables the health server.
# Default: 8080
# HEALTH_PORT=8080

# Local IP address for the HTTP listener. Use 127.0.0.1 when a reverse proxy is local.
# Default: 0.0.0.0
# HEALTH_BIND_ADDRESS=0.0.0.0

# Enable HTTP POST /upload endpoint for photo uploads (syncs to TV).
# Default: false
# UPLOAD_ENABLED=false

# Required HTTP Basic-auth password when uploads are enabled (minimum 16 characters).
# Username: frame
# UPLOAD_TOKEN=replace-with-a-long-random-secret

# Connection timeout for WSS handshake (seconds)
# Default: 60
# CONNECTION_TIMEOUT_SECONDS=60

# API timeout for art API responses (seconds)
# Default: 60
# API_TIMEOUT_SECONDS=60

# Context-cancellable pause between consecutive TV mutations (milliseconds)
# Default: 3000
# UPLOAD_DELAY_MS=3000

# Maximum attempts for a mutation only when the adapter proves the previous
# attempt never reached the TV. Ambiguous or applied outcomes are never retried.
# Default: 3
# UPLOAD_ATTEMPTS=3

# HTTP timeout for the REST gate probe (milliseconds)
# Default: 10000
# GATE_TIMEOUT_MS=10000
